PORT=3000
NODE_ENV=development

# Chat name shown to users (defaults to "Wake")
APP_NAME=Wake

# phpBB Integration
# phpBB URL including app.php, where the Wake Chat extension routes live
# (e.g., https://forum.example.com/app.php). Leave out /app.php only if your
# forum has URL rewriting enabled.
PHPBB_API_ENDPOINT=http://localhost/phpbb/app.php

# Allow users to join as guests without phpBB authentication (true/false)
ALLOW_GUESTS=true

# Allow users to create custom chat rooms (true/false)
ALLOW_ROOM_CREATION=true

# Extra browser origins allowed to connect, comma-separated
# (e.g. https://forum.example.com). The chat's own origin is always allowed.
# '*' allows any website to connect on behalf of logged-in users - dev only.
CORS_ORIGIN=
