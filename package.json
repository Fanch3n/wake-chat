{
  "name": "wake-chat",
  "version": "0.1.0",
  "description": "Real-time group chat application with phpBB SSO integration",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "nodemon --watch src --watch .env --env-file=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "chat",
    "phpbb",
    "sso",
    "socket.io",
    "express"
  ],
  "author": "Fanchen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanch3n/wake-chat.git"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "socket.io-client": "^4.8.3"
  }
}
